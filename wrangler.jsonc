// Config for deploying server/worker.js with wrangler (Cloudflare's command-line tool),
// or for connecting this repository to Cloudflare so pushes deploy automatically.
// Secrets (PLAID_CLIENT_ID, PLAID_SECRET, APP_PASSPHRASE) are NOT listed here on purpose:
// they stay in Cloudflare (Settings > Variables and Secrets, or `wrangler secret put NAME`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocketledger-link",
  "main": "server/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "vars": {
    "PLAID_ENV": "production",
    "ALLOWED_ORIGIN": "https://elijahhalford.com",
    "REDIRECT_URI": "https://elijahhalford.com/pocketledger/"   // for banks that use OAuth; must also be listed in Plaid's allowed redirect URIs
  },
  "kv_namespaces": [
    // The ID is on dash.cloudflare.com > Workers KV > your "pocketledger" namespace. It is not a secret.
    { "binding": "LEDGER", "id": "1914430a77784986a1dcdffa33b766e0" }
  ]
}
